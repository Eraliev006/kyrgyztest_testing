POSTGRES_DB=kyrgyztest
POSTGRES_USER=kyrgyztest
POSTGRES_PASSWORD=your_strong_password_here

# Port the API will be available on (e.g. http://your-server-ip:5000)
API_PORT=5000

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# JWT signing key — minimum 32 characters, keep secret
Jwt__Key=your_jwt_signing_key_minimum_32_characters_here

# Password that the exam administrator enters at the kiosk before candidate login
ExamSettings__AccessPassword=your_exam_room_password